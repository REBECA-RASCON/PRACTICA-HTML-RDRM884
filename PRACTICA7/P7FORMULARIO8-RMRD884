<h2>Formularios con seleccion</h2> <!-- TÍTULO DE NIVEL 2 QUE ENCABEZA LA SECCIÓN -->
<form action="" method="post"> <!-- INICIO DEL FORMULARIO CON MÉTODO POST -->
  Ingresa tu nombre: <!-- TEXTO INFORMATIVO PARA PEDIR EL NOMBRE -->
  <input type="text" name="nombre"> <!-- CAMPO DE TEXTO PARA ESCRIBIR EL NOMBRE -->

  <br> <!-- SALTO DE LÍNEA PARA BAJAR EL SIGUIENTE TEXTO -->
  Selecciona tu pais: <!-- TEXTO INFORMATIVO PARA PEDIR EL PAÍS -->
  <select name="pais"> <!-- INICIO DE LA LISTA DESPLEGABLE DE OPCIONES -->
    <option value="1">Argentina</option> <!-- OPCIÓN 1 ARGENTINA CON VALOR "1" -->
    <option value="2">España</option> <!-- OPCIÓN 2 ESPAÑA CON VALOR "2" -->
    <option value="3">Mexico</option> <!-- OPCIÓN 3 MÉXICO CON VALOR "3" -->
    <option value="4">Guatemala</option> <!-- OPCIÓN 4 GUATEMALA CON VALOR "4" -->
    <option value="5">Honduras</option> <!-- OPCIÓN 5 HONDURAS CON VALOR "5" -->
    <option value="6">El Salvador</option> <!-- OPCIÓN 6 EL SALVADOR CON VALOR "6" -->
    <option value="7">Venezuela</option> <!-- OPCIÓN 7 VENEZUELA CON VALOR "7" -->
    <option value="8">Colombia</option> <!-- OPCIÓN 8 COLOMBIA CON VALOR "8" -->
  </select> <!-- FIN DE LA LISTA DESPLEGABLE DE OPCIONES -->
  <br> <!-- SALTO DE LÍNEA PARA BAJAR LOS BOTONES -->
  <input type="submit" value="enviar"> <!-- BOTÓN TIPO INPUT PARA ENVIAR EL FORMULARIO -->
  <input type="reset" value="borrar"> <!-- BOTÓN TIPO INPUT PARA LIMPIAR EL FORMULARIO -->
</form> <!-- FIN DEL FORMULARIO -->
